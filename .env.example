# Copy this file to .env and fill in your keys
# Get your Anthropic API key at: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# VoyageAI — used for RAG embeddings (free tier: 50M tokens/month)
# Get your key at: https://dash.voyageai.com
VOYAGE_API_KEY=your_voyage_api_key_here

# Supabase — persistent storage (free tier)
# Get your keys at: https://supabase.com → project → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional: OpenAI (if you want to use GPT models with LangChain)
# OPENAI_API_KEY=your_openai_api_key_here

# Admin dashboard auth (set in frontend/.env.local)
# ADMIN_PASSWORD=your-admin-password
# ADMIN_TOKEN=random-secret-token  (generate with: openssl rand -hex 16)

# Optional: LangSmith (for tracing and debugging)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_langsmith_api_key_here
# LANGCHAIN_PROJECT=DivAi
