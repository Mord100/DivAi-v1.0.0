# Copy this file to .env and fill in your keys

# OpenRouter — routes LLM calls to any model (Claude, GPT-4, Llama, etc.)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Which model to use (OpenRouter model ID)
# Claude Sonnet 4.6: anthropic/claude-sonnet-4-6
# Claude Haiku 4.5:  anthropic/claude-haiku-4-5
# GPT-4o:            openai/gpt-4o
LLM_MODEL=anthropic/claude-sonnet-4-6

# Legacy — only needed if using Anthropic SDK directly
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# VoyageAI — used for RAG embeddings (free tier: 50M tokens/month)
# Get your key at: https://dash.voyageai.com
VOYAGE_API_KEY=your_voyage_api_key_here

# Supabase — persistent storage (free tier)
# Get your keys at: https://supabase.com → project → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional: OpenAI (if you want to use GPT models with LangChain)
# OPENAI_API_KEY=your_openai_api_key_here

# Admin dashboard auth (set in frontend/.env.local)
# ADMIN_PASSWORD=your-admin-password
# ADMIN_TOKEN=random-secret-token  (generate with: openssl rand -hex 16)

# Optional: LangSmith (for tracing and debugging)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_langsmith_api_key_here
# LANGCHAIN_PROJECT=DivAi
